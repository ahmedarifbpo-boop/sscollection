generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ PRODUCTS ============
model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  price       Float
  salePrice   Float?
  stock       Int      @default(0)
  image       String
  rating      Float    @default(4.5)
  reviews     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
}

// ============ ORDERS ============
model Order {
  id                String   @id @default(cuid())
  orderNumber       String   @unique
  customerName      String
  customerPhone     String
  customerAddress   String
  customerEmail     String?
  notes             String?
  subtotal          Float
  shipping          Float    @default(0)
  total             Float
  status            String   @default("PENDING")
  paymentMethod     String   @default("COD")
  
  // Naye Features (Email Verification ke liye)
  isVerified        Boolean  @default(false)
  verificationToken String?  @unique
  
  // Naya Feature (Referral & Coins ke liye)
  customerId        String?  // Kis customer ne order kiya
  coinsUsed         Float    @default(0) // Kitne coins use kiye
  coinsEarned       Float    @default(0) // Kitne coins mile (3%)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             OrderItem[]
  customer          Customer? @relation(fields: [customerId], references: [id])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  name       String
  price      Float
  quantity   Int
  image      String
  createdAt  DateTime @default(now())
}

// ============ CATEGORIES ============
model Category {
  id         String   @id @default(cuid())
  name       String   @unique
  icon       String?
  createdAt  DateTime @default(now())
}

// ============ OFFERS (Hero Slider) ============
model Offer {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  image      String
  ctaText    String   @default("Shop Now")
  ctaLink    String   @default("/")
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ============ CHAT ============
model ChatConversation {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  customerName   String?
  customerPhone  String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages       ChatMessage[]
}

model ChatMessage {
  id              String            @id @default(cuid())
  conversationId  String
  conversation    ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          String
  text            String
  createdAt       DateTime          @default(now())
}

// ============ ADMIN ============
model Admin {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  createdAt  DateTime @default(now())
}

// ============ Settings ============
model Settings {
  id                     String   @id @default(cuid())
  storeName              String   @default("S.S Collection")
  contactEmail           String?
  contactPhone           String?
  address                String?
  freeShippingThreshold  Float    @default(5000)
  shippingFee            Float    @default(250)
  enableFreeShipping     Boolean  @default(true)
  logoUrl                String?
  updatedAt              DateTime @updatedAt
}

// ============ VISITOR LOG ============
model VisitorLog {
  id        String   @id @default(cuid())
  ip        String
  page      String
  createdAt DateTime @default(now())
}

// ============ CUSTOMER (NEW) ============
model Customer {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String   @unique
  referralCode   String   @unique // Har customer ka apna code
  referredBy     String?  // Jisne refer kiya (uska code)
  coins          Float    @default(0)
  totalReferrals Int      @default(0)
  hasOrdered     Boolean  @default(false) // Pehla order hua ya nahi
  canRefer       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders         Order[]
}

// ============ REFERRAL LOG (NEW) ============
model ReferralLog {
  id             String   @id @default(cuid())
  referrerCode   String   // Jisne refer kiya (code)
  referredEmail  String   // Naye customer ki email
  status         String   @default("PENDING") // PENDING, COMPLETED
  coinsAwarded   Float    @default(0)
  createdAt      DateTime @default(now())
}