
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ PRODUCTS ============

model Product {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  description          String
  category             String
  price                Float
  salePrice            Float?
  costPrice            Float    @default(0)
  stock                Int      @default(0)
  isManuallyOutOfStock Boolean  @default(false)

  image                String   @default("")
  images               String[] @default([])
  video                String?

  rating               Float    @default(0)
  reviews              Int      @default(0)

  metaTitle            String?
  metaDescription      String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orderItems           OrderItem[]
  reviewsData          Review[]
  expenseSheetRows     ExpenseSheetRow[]

  @@index([category])
  @@index([slug])
}

// ============ ORDERS ============

model Order {
  id                       String   @id @default(cuid())
  orderNumber              String   @unique

  customerName             String
  customerPhone            String
  customerAlternativePhone String?
  customerAddress          String
  customerEmail            String?
  notes                    String?

  subtotal                 Float
  shipping                 Float    @default(0)
  courierCost              Float    @default(0)
  total                    Float

  status                   String   @default("PENDING")
  paymentMethod            String   @default("COD")

  isVerified               Boolean  @default(false)
  allowOpenParcel          Boolean  @default(false)
  verificationToken        String?  @unique

  reviewToken              String?  @unique

  historyToken             String?  @db.VarChar(128)

  customerId               String?
  coinsUsed                Float    @default(0)
  coinsEarned              Float    @default(0)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  items                    OrderItem[]
  customer                 Customer? @relation(fields: [customerId], references: [id])
  reviews                  Review[]
  returnRequests           ReturnRequest[]

  @@index([status])
  @@index([customerId])
  @@index([historyToken])
}

// ============ ORDER ITEMS ============

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  name       String
  price      Float
  actualCost Float    @default(0)
  quantity   Int
  image      String

  createdAt  DateTime @default(now())

  @@index([orderId])
}

// ============ PRODUCT REVIEWS ============

model Review {
  id               String   @id @default(cuid())

  productId        String
  orderId          String
  customerId       String?

  customerName     String
  rating           Int
  comment          String

  status           String   @default("PENDING")
  verifiedPurchase Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([orderId, productId])
  @@index([productId, status])
  @@index([customerId])
  @@index([orderId])
}

// ============ CATEGORIES ============

model Category {
  id         String   @id @default(cuid())
  name       String   @unique
  slug       String   @unique
  icon       String?
  createdAt  DateTime @default(now())
}

// ============ OFFERS ============

model Offer {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  image      String?
  video      String?
  ctaText    String   @default("Shop Now")
  ctaLink    String   @default("/")
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ============ CHAT ============

model ChatConversation {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  customerName   String?
  customerPhone  String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages       ChatMessage[]
}

model ChatMessage {
  id              String            @id @default(cuid())
  conversationId  String
  conversation    ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender          String
  text            String
  createdAt       DateTime          @default(now())

  @@index([conversationId])
}

// ============ ADMIN ============

model Admin {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  createdAt  DateTime @default(now())
}

// ============ SETTINGS ============

model Settings {
  id                     String   @id @default(cuid())
  storeName              String   @default("S.S Collection")
  contactEmail           String?
  contactPhone           String?
  address                String?

  freeShippingThreshold  Float?
  shippingFee            Float    @default(250)
  enableFreeShipping     Boolean  @default(true)

  logoUrl                String?

  // Google AdSense
  adsenseCode            String?  @db.Text
  adsenseEnabled         Boolean  @default(false)

  // Adsterra
  adsterraCode           String?  @db.Text
  adsterraEnabled        Boolean  @default(false)

  updatedAt              DateTime @updatedAt
}

// ============ VISITOR LOG ============

model VisitorLog {
  id               String   @id @default(cuid())
  ip               String
  visitorId        String?
  sessionId        String?
  page             String
  browser          String?
  deviceType       String?
  eventType        String   @default("page_view")
  productId        String?
  trafficSource    String?
  referrer         String?
  city             String?
  country          String?
  durationSeconds  Int?
  eventData        Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([eventType])
  @@index([visitorId])
  @@index([sessionId])
  @@index([productId])
}

// ============ CUSTOMER ============

model Customer {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String   @unique

  referralCode   String   @unique
  referredBy     String?

  coins          Float    @default(0)
  totalReferrals Int      @default(0)

  hasOrdered     Boolean  @default(false)
  canRefer       Boolean  @default(true)

  historyToken   String?  @unique @db.VarChar(128)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders         Order[]
  reviews        Review[]
}

// ============ REFERRAL LOG ============

model ReferralLog {
  id             String   @id @default(cuid())
  referrerCode   String
  referredEmail  String
  status         String   @default("PENDING")
  coinsAwarded   Float    @default(0)
  createdAt      DateTime @default(now())

  @@index([referrerCode])
}

// ============ RETURN REQUESTS ============

model ReturnRequest {
  id              String   @id @default(cuid())

  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  reason          String
  details         String?

  customerPhone   String
  customerEmail   String?
  customerAddress String

  images          String[] @default([])
  videos          String[] @default([])

  status          String   @default("NEW")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// ============ ADMIN EXPENSE RECORDS ============

model ExpenseRecord {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  type      String
  amount    Float
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type])
}

// ============ EXPENSE SHEET ROWS ============

model ExpenseSheetRow {
  id                String   @id @default(cuid())
  date              DateTime

  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName       String   @default("")
  actualPrice       Float    @default(0)
  websitePrice      Float    @default(0)

  personalExpense   Float    @default(0)
  businessExpense   Float    @default(0)

  fuelCharges       Float    @default(0)
  deliveryCharges   Float    @default(0)

  discountSalePrice Float    @default(0)
  discountQuantity  Int      @default(0)

  note              String?
  customValues      Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([date, productId])
  @@index([date])
  @@index([productId])
}

// ============ EXPENSE SHEET SETTINGS ============

model ExpenseSheetSettings {
  id                   String   @id @default("main")
  accountBalance       Float    @default(0)
  actualCountedBalance Float    @default(0)
  updatedAt            DateTime @updatedAt
}

// ============ EXPENSE SHEET PAYMENTS ============

model ExpenseSheetPayment {
  id        String   @id @default(cuid())
  person    String
  amount    Float
  date      DateTime @default(now())
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([person, date])
}

// ============ EXPENSE SHEET CUSTOM COLUMNS ============

model ExpenseSheetColumn {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("TEXT")
  formula   String?
  position  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}
